# Ejemplo sin secretos. make setup genera contrasenas aleatorias en .env ignorado.
CDRL_DATABASE_MODE=local
POSTGRES_HOST=localhost
POSTGRES_DB=cdrl
POSTGRES_USER=cdrl_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
MIGRATOR_USER=cdrl_migrator
MIGRATOR_PASSWORD=
WRITER_USER=cdrl_writer
WRITER_PASSWORD=
READER_USER=cdrl_reader
READER_PASSWORD=
OPERATOR_USER=cdrl_operator
OPERATOR_PASSWORD=
# Para modo external usar TLS con validacion de certificado.
POSTGRES_SSL=false
POSTGRES_SSL_CA_FILE=

# MongoDB (M05). node scripts/mongo.mjs genera MONGO_PASSWORD en .env (ignorado por Git).
MONGO_USER=cdrl_mongo
MONGO_PASSWORD=
MONGO_PORT=27017
MONGO_HOST=127.0.0.1
MONGO_DB=cdrl
MONGO_AUTH_SOURCE=cdrl
MONGO_APP_USER=cdrl_app
MONGO_APP_PASSWORD=
# M09: cuentas por coleccion y operacion. make setup genera cada secreto en .env.
MONGO_INGEST_USER=cdrl_mongo_ingest
MONGO_INGEST_PASSWORD=
MONGO_READER_USER=cdrl_mongo_reader
MONGO_READER_PASSWORD=
MONGO_OPERATOR_USER=cdrl_mongo_operator
MONGO_OPERATOR_PASSWORD=
MONGO_AUDITOR_USER=cdrl_mongo_auditor
MONGO_AUDITOR_PASSWORD=
